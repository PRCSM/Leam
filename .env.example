# Public site URL (used for metadata, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://leam.example

# Optional: a licensed promo clip for the hero video button (mp4/webm URL).
# Without it the button opens a labelled interactive walkthrough instead.
NEXT_PUBLIC_PROMO_VIDEO_URL=

# Optional: real-time rooms via LiveKit. When all three are set, /api/rooms/token
# mints signed access tokens server-side. The secret never reaches the browser.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
